 "cells": [
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys\\n",
    "sys.path.append('../')\\n",
    "import networkx as nx\\n",
    "from src.graph import PhysarumGraph\\n",
    "from src.solvers.discrete_solver import DiscreteSolver\\n",
    "from src.benchmarking.task_generator import generate_grid_graph\\n",
    "from src.benchmarking.benchmark_algorithms import mst_steiner_tree_heuristic\\n",
    "from src.benchmarking.performance_analyzer import calculate_solution_cost, plot_comparison\\n",
    "import time"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Generate a grid graph\\n",
    "graph = generate_grid_graph(10, 10)\\n",
    "terminals = [(0, 0), (9, 9)]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# --- Physarum Discrete Solver --- \\n",
    "physarum_graph = graph.copy()\\n",
    "source_node, sink_node = terminals\\n",
    "solver = DiscreteSolver(physarum_graph, source_node, sink_node)\\n",
    "start_time = time.time()\\n",
    "solver.run_simulation_with_t_point()\\n",
    "physarum_time = time.time() - start_time\\n",
    "# Binarize the result for cost calculation\\n",
    "conductivity_threshold = 0.1 # Example threshold\\n",
    "physarum_result = PhysarumGraph()\\n",
    "for u, v, data in physarum_graph.edges(data=True):\\n",
    "    if data['conductivity'] > conductivity_threshold:\\n",
    "        physarum_result.add_edge(u, v)\\n",
    "physarum_cost = calculate_solution_cost(physarum_result)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# --- MST Heuristic --- \\n",
    "mst_graph = graph.copy()\\n",
    "start_time = time.time()\\n",
    "mst_result = mst_steiner_tree_heuristic(mst_graph, terminals)\\n",
    "mst_time = time.time() - start_time\\n",
    "mst_cost = calculate_solution_cost(mst_result)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# --- Comparison --- \\n",
    "results = {\\n",
    "    'Physarum (T-Point)': {'cost': physarum_cost, 'time': physarum_time},\\n",
    "    'MST Heuristic': {'cost': mst_cost, 'time': mst_time}\\n",
    "}\\n",
    "plot_comparison(results)"
   ]
  }
 ],
